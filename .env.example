# OpenAI-compatible chat/completions endpoint, including /v1 when required.
OPENAI_BASE_URL=
OPENAI_API_KEY=
DIAG_MODEL=
# Local endpoints may leave OPENAI_API_KEY blank.
DIAG_CONCURRENCY=2
DIAG_MAX_RETRIES=2
DIAG_TIMEOUT=120
# Match the upstream run_pipeline.sh output cap and per-step parallelism.
DIAG_MAX_TOKENS=32768
DIAG_LLM_CONCURRENCY=8
# The upstream clustering prompt lacks the JSON keyword required by some APIs.
# Use its supported plain-output mode; the official JSON parser stays unchanged.
DIAG_CLUSTER_JSON_MODE=false
TRACELENS_DATA_DIR=./data/production
# Enable benchmark import APIs only when running a separate validation workspace.
TRACELENS_ENABLE_VALIDATION_DATA=false

